# BlueprintBot v2 - Environment Configuration Template
# Copy this file to .env and update the values for your environment

# Application Settings
BLUEPRINTBOT_ENV=production
BLUEPRINTBOT_HOST=0.0.0.0
BLUEPRINTBOT_PORT=8000
BLUEPRINTBOT_WORKERS=4
BLUEPRINTBOT_LOG_LEVEL=INFO

# Database Configuration
POSTGRES_PASSWORD=your-secure-postgres-password
DATABASE_URL=postgresql://blueprintbot:your-secure-postgres-password@postgres:5432/blueprintbot

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password
REDIS_URL=redis://redis:6379/0

# Security Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters
ENCRYPTION_KEY=your-super-secret-encryption-key-32-chars

# Quantum Computing API Keys
IBM_QUANTUM_TOKEN=your-ibm-quantum-token-here
QUANTUM_BACKEND=qasm_simulator

# AI/ML API Keys
OPENAI_API_KEY=your-openai-api-key-here
HUGGINGFACE_TOKEN=your-huggingface-token-here

# Cloud Provider Settings (AWS)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# Cloud Provider Settings (Azure)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Cloud Provider Settings (Google Cloud)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Cloudflare Settings
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
DOMAIN_NAME=infinite2025.com

# SSL/TLS Settings
ACME_EMAIL=admin@infinite2025.com

# Monitoring and Observability
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-secure-grafana-password
PROMETHEUS_RETENTION=200h

# Object Storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-secure-minio-password

# Task Queue (Celery)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Flower (Celery Monitoring)
FLOWER_USER=admin
FLOWER_PASSWORD=your-secure-flower-password

# Performance Settings
MAX_UPLOAD_SIZE=104857600
MAX_CONCURRENT_ANALYSES=10
QUANTUM_TIMEOUT=300
AI_TIMEOUT=600

# Development Settings (only for development environment)
DEBUG=false
RELOAD=false
PROFILING_ENABLED=false

# External Integrations
SLACK_WEBHOOK_URL=your-slack-webhook-url
DISCORD_WEBHOOK_URL=your-discord-webhook-url
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-email-app-password

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=blueprintbot-backups

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=10

# Caching
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Logging
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# Feature Flags
ENABLE_QUANTUM_PROCESSING=true
ENABLE_AI_ACCELERATION=true
ENABLE_GPU_ACCELERATION=false
ENABLE_DISTRIBUTED_PROCESSING=false
ENABLE_WEBSOCKETS=true
ENABLE_GRAPHQL=true
ENABLE_GRPC=false
ENABLE_STREAMING=true
ENABLE_WEBHOOKS=true
ENABLE_SSE=true

# Integration Settings
ENABLE_KUBERNETES=false
ENABLE_DOCKER=true
ENABLE_CLOUD_STORAGE=true
ENABLE_MESSAGE_QUEUE=true
ENABLE_SERVICE_MESH=false

# Advanced Settings
ENABLE_COMPRESSION=true
ENABLE_HTTP2=true
ENABLE_CONNECTION_POOLING=true
ENABLE_ASYNC_PROCESSING=true
ENABLE_LOAD_BALANCING=false

# Development Tools
ENABLE_SWAGGER=true
ENABLE_REDOC=true
ENABLE_ADMIN_PANEL=true
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILING=false

# Custom Domain and SSL
CUSTOM_DOMAIN=app.infinite2025.com
SSL_CERTIFICATE_PATH=/etc/ssl/certs/infinite2025.com.crt
SSL_PRIVATE_KEY_PATH=/etc/ssl/private/infinite2025.com.key

# Analytics and Tracking
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token
SEGMENT_WRITE_KEY=your-segment-write-key

# Social Authentication
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret

# Webhook Endpoints
WEBHOOK_SECRET=your-webhook-secret-key
WEBHOOK_TIMEOUT=30

# API Versioning
API_VERSION=v2
API_PREFIX=/api/v2

# CORS Settings
CORS_ORIGINS=https://infinite2025.com,https://app.infinite2025.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline'
CSP_STYLE_SRC='self' 'unsafe-inline'
CSP_IMG_SRC='self' data: https:

# Session Settings
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_TIMEOUT=3600

# File Upload Settings
UPLOAD_DIRECTORY=/app/uploads
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.bmp,.tiff,.pdf,.dwg,.dxf
VIRUS_SCANNING_ENABLED=false

# Notification Settings
EMAIL_NOTIFICATIONS_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=false
SMS_NOTIFICATIONS_ENABLED=false

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System under maintenance. Please try again later."

# Health Check Settings
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

